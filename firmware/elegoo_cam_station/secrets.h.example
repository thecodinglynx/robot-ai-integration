// Copy this file to secrets.h and fill in your own network.
//
// secrets.h is git-ignored. The car joins this network in station mode, and
// keeps its own access point as a fallback, so wrong credentials here leave it
// reachable at 192.168.4.1 rather than stranded.
//
// The network must not isolate clients from each other. Proved the hard way on
// a guest SSID where a laptop and a phone on the same subnet could not see each
// other at all: station mode is useless there however well the car joins. Test
// by pinging one device on it from another BEFORE flashing.
#pragma once

static const char *STA_SSID = "your-network";
static const char *STA_PASS = "your-password";
